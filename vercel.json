{
  "buildCommand": "bun run build:assets && python scripts/prepare_vercel_static.py",
  "regions": ["arn1"],
  "functions": {
    "api/index.py": {
      "includeFiles": "app/**",
      "excludeFiles": "{data/**,tests/**,node_modules/**,.venv/**}",
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/internal/cron/refresh-warehouse-volunteer-counts",
      "schedule": "17 * * * *"
    },
    {
      "path": "/internal/cron/enqueue-recruiter-digests",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/internal/cron/dispatch-email-deliveries",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
