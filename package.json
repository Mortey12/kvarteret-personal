{
  "name": "kvarteret-personal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build:css": "bunx @tailwindcss/cli -i ./app/static/css/input.css -o ./app/static/css/output.css",
    "build:js": "bun build ./app/static/js/vercel-observability.ts --outfile ./app/static/js/vercel-observability.js --format esm --target browser --define process.env.NODE_ENV='\"production\"'",
    "build:email-previews": "uv run python ./scripts/render_email_previews.py",
    "build:emails": "bun run typecheck:emails && bun run ./scripts/compile_react_email_templates.tsx && bun run build:email-previews",
    "build:i18n": "uv run python ./scripts/compile_gettext_catalogs.py",
    "build:assets": "bun run build:css && bun run build:js && bun run build:emails && bun run build:i18n",
    "watch:css": "bunx @tailwindcss/cli -i ./app/static/css/input.css -o ./app/static/css/output.css --watch",
    "typecheck:emails": "tsc --project tsconfig.email.json",
    "preview:emails": "email dev --dir app/templates/emails/react --port 3001"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvarteret/kvarteret-personal.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/kvarteret/kvarteret-personal/issues"
  },
  "homepage": "https://github.com/kvarteret/kvarteret-personal#readme",
  "description": "FastAPI replacement for Kvarteret Personal",
  "devDependencies": {
    "@react-email/render": "2.1.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "picomatch": "^4.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "@parcel/watcher": "2.6.0",
    "source-map-js": "1.2.2",
    "fast-uri": "^3.1.9"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "brace-expansion": "^5.0.12",
    "tw-animate-css": "^1.4.0"
  }
}
